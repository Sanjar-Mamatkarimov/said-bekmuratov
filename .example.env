# =============================================
# Django — переменные окружения (шаблон)
# Скопируйте в .env и заполните
# =============================================

# Секретный ключ Django (сгенерируйте: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=

# Режим отладки: True — локально, False — продакшен
DJANGO_DEBUG=True

# Разрешённые хосты через запятую
# Для Vercel: .vercel.app (подхватывает все поддомены)
# Для своего домена: your-domain.com
DJANGO_ALLOWED_HOSTS=

# Trusted origins для CSRF — через запятую (с протоколом https://)
# Пример: https://said-bekmuratov.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL URL (оставьте пустым для SQLite локально)
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Telegram уведомления
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
